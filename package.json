{
  "name": "code-atlas",
  "version": "1.0.0",
  "description": "Repository explainer with AI-powered analysis and diagrams",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "repoexplain": "./dist/cli.js",
    "rx": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "cli": "node --loader ts-node/esm src/cli.ts"
  },
  "keywords": [
    "repository",
    "documentation",
    "ai",
    "diagrams",
    "code-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "ignore": "^5.3.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/ui": "^1.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "ts-node": "^10.9.2"
  }
}
